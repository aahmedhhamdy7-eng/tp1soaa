<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="universite">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="etudiants">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="etudiant"
                                        minOccurs="1"
                                        maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nom"
                                                    type="xs:string"/>
                                        <xs:element name="prenom"
                                                    type="xs:string"/>
                                        <xs:element name="dateNaissance"
                                                    type="xs:date"/>
                                        <xs:element name="email"
                                                    type="xs:string"/>
                                        <xs:element name="filiere"
                                                    type="xs:string"/>
                                        <xs:element name="niveau"
                                                    type="xs:positiveInteger"/>
                                        <xs:element name="moyenne"
                                                    type="xs:decimal"/>
                                    </xs:sequence>

                                    <xs:attribute name="id"
                                                  type="xs:ID"
                                                  use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>

            <xs:attribute name="nom"
                          type="xs:string"
                          use="required"/>
            <xs:attribute name="anneeUniversitaire"
                          type="xs:string"
                          use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
